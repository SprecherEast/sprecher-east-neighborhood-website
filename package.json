{
  "name": "sprecher-east-neighborhood-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "prepare": "husky",
    "knip": "knip",
    "duplication": "jscpd",
    "agent-context": "node scripts/agent-context.mjs",
    "filing-checklist": "node .github/scripts/filing-checklist.mjs --write",
    "audit:prod": "node scripts/audit-prod.mjs",
    "knowledge:check": "node scripts/knowledge-check.mjs",
    "knowledge:structure": "node scripts/knowledge-structure/cli.mjs",
    "knowledge:map": "tsx --tsconfig tsconfig.json scripts/knowledge-map/cli.mjs",
    "docs:generate": "tsx --tsconfig tsconfig.json scripts/generate-reference.mjs",
    "docs:check": "tsx --tsconfig tsconfig.json scripts/generate-reference.mjs --check",
    "developer:dev": "cross-env NODE_OPTIONS=--no-deprecation next dev developer -p 3200",
    "developer:build": "cross-env NODE_OPTIONS=--no-deprecation next build developer",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "storybook:build": "storybook build -o storybook-static --disable-telemetry",
    "typecheck:storybook": "tsc -p .storybook/tsconfig.json --noEmit"
  },
  "dependencies": {
