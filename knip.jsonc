{
  // Finds files, exports and packages nothing uses (#445). Run: npm run knip. Plugins read
  // Next.js, Vitest, ESLint, Prettier, lint-staged and husky by themselves; these are the
  // entry points they can't see.
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // An export used in its own file (a constant a test or a type also reads) is not dead code
  "ignoreExportsUsedInFile": true,
  // Also check what the entry files export, so a re-export nothing imports is reported
  "includeEntryExports": true,
  // The system's own tools that a test runs (openssl makes and opens the keys the preview sign-in is sealed with, #1394; flock holds the lock and mkfifo makes the pipe the content copy's tests check, #1397)
  "ignoreBinaries": ["openssl", "flock", "mkfifo"],
  "ignoreIssues": {
    // PM2 reads the default export on the server
    "ecosystem.config.cjs": ["exports"],
    // Next.js reads the exports of the developer pages' routes (default component, `metadata`); knip's Next
    // plugin only knows src/app (#1530)
    "developer/app/**": ["exports"],
    // Kept on purpose: only its tests call it today (#756)
    "src/modules/accounts/server.ts": ["exports"],
    // Every export is an example, read by name by the showcase and the tests (#1532)
    "src/platform/{ui,richtext}/**/*.examples.tsx": ["exports"],
  },
  "workspaces": {
    ".": {
      "entry": [
        // A module's entry files are its public contract (architecture rule 2)
        "src/modules/*/{index,server,cms,actions}.ts",
        "src/platform/*/index.ts",
        // Run on the server, not imported: the PM2 config and the backup script (ops/*.sh)
        "ecosystem.config.cjs",
        "ops/*.mjs",
        // Run by hand or by CI
        "scripts/*.{ts,mjs}",
        // The About page map picture generator (#1419): run by hand
        "scripts/map-preview/build.mjs",
        // Loaded by the PR Policy workflow (#716); their tests are found by Vitest
        ".github/scripts/*.mjs",
        // The knowledge eval (#715): run by hand, never in CI; its tests are found by Vitest
        "scripts/knowledge-eval/{run,analyze}.mjs",
        // The knowledge structure check (#1460): run by hand and by `Knowledge sync`
        "scripts/knowledge-structure/cli.mjs",
        // Run by `payload run` from e2e/serve.mjs (which knip finds through playwright.config.ts)
        "e2e/seed.ts",
        // Run by `payload run` from ops/deploy-release.sh on the server, for a preview's first database (#1075)
        "e2e/previewSeed.ts",
        // Run by `payload run`, the export from production's release and the import from a preview's own tree (#1396)
        "e2e/previewCopy{Export,Import}.ts",
        // Imported by eslint.config.mjs
        "eslint.*.config.mjs",
        // The developer pages (#1530) are a second Next.js project: its routes are entries
        "developer/app/**/{page,layout,not-found}.tsx",
        // The showcase examples (#1532): read by the showcase pages and the reference generator, which knip can't see
        "src/platform/{ui,richtext}/**/*.examples.tsx",
      ],
      "ignoreDependencies": [
        // Loaded from CSS (globals.css `@import` and `@plugin`), which knip doesn't read
        "@tailwindcss/typography",
        "tw-animate-css",
        // Installed globally on the server (ops/), not in this package
        "pm2",
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "developer/**/*.{ts,tsx}",
        "ops/**/*.mjs",
        "scripts/**/*.{ts,mjs}",
        // The end-to-end tests (#311): Playwright finds the specs from playwright.config.ts
        "e2e/**/*.{ts,mjs}",
        // The showcase's font is loaded from here (`@import`), so knip sees the package used (#1459)
        ".storybook/**/*.css",
      ],
      "ignore": [
        // Built but not shown yet (docs/ui/evidence.md); kept for the theme work
        "src/platform/theme/ThemeSelector.client.tsx",
      ],
    },
    // Its own package, with its own lockfile and tests (node --test)
    "intelligence/runner": {
      "entry": ["test/*.test.mjs"],
      "project": ["**/*.mjs"],
    },
  },
}
