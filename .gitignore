# Next.js
.next/
out/

# Dependencies
node_modules/

# Environment variables (never commit these)
.env.local
.env.*.local

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/settings.json
*.swp
*.swo

# Legacy backup (local only — filenames too long for Windows Git)
_legacy/

# Payload CMS + Auth SQLite databases (local data, never commit)
data/payload.db
data/payload.db-shm
data/payload.db-wal
data/payload-build.db
data/payload-build.db-shm
data/payload-build.db-wal

# Sitemap files the old next-sitemap build wrote. Never commit them; ops/restart-app.sh deletes any
# left on the server, since Next serves public/ ahead of app/sitemap.ts and app/robots.ts (#267)
public/sitemap*.xml
public/robots.txt

# Uploaded media (managed by Payload, preserved on VPS separately)
public/media/

# SSH keys — NEVER commit private keys
*.pem
# The off-site backup's public certificate and a public test key are meant to be committed (#1332); no private key ever is
!ops/offsite-backup-cert.pem
!ops/fixtures/rsa-8704-public.pem
!ops/fixtures/dsa-3072-public.pem
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
sprecher-east
sprecher-east.pub

# Claude Code — local settings (project settings.json is OK to commit)
.claude/settings.local.json
CLAUDE.local.md

# Playwright MCP
.playwright-mcp/

# Local screenshots
homepage-local.png

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
/coverage

# Editors / IDEs
.idea/

# Environment variables (bare .env is never committed either)
.env

# Claude Code — local agent state (project settings.json is OK to commit)
.claude/agent-memory/
.claude/worktrees/

# Other local agent tooling
.claire/

# Local scratch media (root-level screenshots, source photo dumps)
/*.png
/*.jpg
Sprecher-East-Photo_Album/

# End-to-end tests (#311): the throwaway database and caught emails, and Playwright output
e2e/.data/
test-results/
playwright-report/
__pycache__/
e2e/.data-passkeys/

# Storybook static build (#1447)
storybook-static/

# The component showcase built into a release (ops/build-showcase.sh, #1459). Tailwind's source detection skips
# ignored files, so the site's CSS never grows with the showcase's classes. A test keeps these two paths here.
/developer-site/
/public/showcase/

# Change history and open-issue snapshot of the system map, written by `npm run knowledge:map -- --extras` (#1462)
.knowledge-map/

# The system map's data, built from the sources by `npm run knowledge:map`; never committed (#1581)
/docs/knowledge/graph.json
/docs/knowledge/catalog.md

# Rules built from the guidelines and notes by scripts/agent-context-rules.mjs; rebuilt where needed, never committed (#1593)
/.claude/rules/generated/
