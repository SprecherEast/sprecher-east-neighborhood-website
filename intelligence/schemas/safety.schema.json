{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/safety.schema.json",
  "title": "What counts as a safety item (safety.yaml)",
  "type": "object",
  "required": ["version", "meaning", "topics"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "meaning": { "type": "string", "minLength": 1, "maxLength": 600 },
    "topics": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "means", "terms"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/sourceId" },
          "means": { "type": "string", "minLength": 1, "maxLength": 300 },
          "terms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z]+( [a-z]+)*$", "maxLength": 40 }
          }
        }
      }
    }
  }
}
