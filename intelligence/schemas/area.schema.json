{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/area.schema.json",
  "title": "The words code uses to tell that an item is about the area (area.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "places", "neighbors", "boundary", "highways"],
  "$defs": {
    "words": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 ./-]*[a-z0-9]$", "maxLength": 60 }
    }
  },
  "properties": {
    "version": { "const": 1 },
    "places": { "$ref": "#/$defs/words" },
    "neighbors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "checked", "names"],
      "properties": {
        "source": { "type": "string", "pattern": "^https://" },
        "checked": { "$ref": "common.schema.json#/$defs/date" },
        "names": { "$ref": "#/$defs/words" }
      }
    },
    "boundary": {
      "description": "The City's own boundary feature for the area: where the dated copy is, how it was verified, and the City's locator that turns a street address into a point (runner/lib/place.mjs). `verified` is false until someone confirms the layer and ID by hand; until then items are placed by word match.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "field",
        "naId",
        "file",
        "maxAgeDays",
        "terms",
        "checked",
        "verified",
        "geocoder"
      ],
      "properties": {
        "source": { "type": "string", "pattern": "^https://" },
        "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "naId": { "type": "integer", "minimum": 1 },
        "file": { "type": "string", "pattern": "^[a-z0-9-]+\\.json$" },
        "maxAgeDays": { "type": "integer", "minimum": 30, "maximum": 3650 },
        "terms": { "type": "string", "pattern": "^https://" },
        "checked": { "$ref": "common.schema.json#/$defs/date" },
        "verified": { "type": "boolean" },
        "geocoder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "minScore",
            "sameSpotMeters",
            "maxPerRun",
            "timeoutSeconds",
            "maxKilobytes"
          ],
          "properties": {
            "source": { "type": "string", "pattern": "^https://" },
            "minScore": { "type": "number", "minimum": 50, "maximum": 100 },
            "sameSpotMeters": { "type": "number", "minimum": 0, "maximum": 200 },
            "maxPerRun": { "type": "integer", "minimum": 0, "maximum": 200 },
            "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
            "maxKilobytes": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        }
      }
    },
    "highways": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["names", "with"],
        "properties": {
          "names": { "$ref": "#/$defs/words" },
          "with": { "$ref": "#/$defs/words" }
        }
      }
    }
  }
}
