{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/boundary.schema.json",
  "title": "The dated copy of the City's boundary for the area (boundary.json)",
  "description": "One feature of the City's Neighborhood Associations layer, in longitude and latitude (WGS 84), as `node run.mjs --refresh-boundary` writes it. The runner refuses to start on a copy that fails this schema or runner/lib/boundary.mjs's checks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "naId", "fetchedAt", "geometry"],
  "properties": {
    "source": { "type": "string", "pattern": "^https://" },
    "naId": { "type": "integer", "minimum": 1 },
    "fetchedAt": { "$ref": "common.schema.json#/$defs/date" },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "description": "Rings of [longitude, latitude]: the outer ring first, then any holes. Each is closed.",
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 2000,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
