{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprechereast.com/intelligence/schemas/pipeline.schema.json",
  "title": "Pipeline settings (pipeline.yaml)",
  "type": "object",
  "required": [
    "version",
    "enabled",
    "schedule",
    "budgets",
    "lookAheadDays",
    "lowWater",
    "sources",
    "coverage",
    "area",
    "safety",
    "background",
    "stages",
    "escalation",
    "promotionGuard",
    "routes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "enabled": { "type": "boolean" },
    "schedule": {
      "type": "object",
      "required": ["cron", "timezone"],
      "additionalProperties": false,
      "properties": {
        "cron": { "type": "string", "minLength": 1, "maxLength": 50 },
        "timezone": { "const": "America/Chicago" }
      }
    },
    "budgets": {
      "type": "object",
      "required": [
        "maxUsdPerRun",
        "maxUsdPerMonth",
        "maxMinutesPerRun",
        "maxItemsPerSource",
        "maxModelItemsPerRun",
        "maxDraftsPerRun"
      ],
      "additionalProperties": false,
      "properties": {
        "maxUsdPerRun": { "type": "number", "exclusiveMinimum": 0 },
        "maxUsdPerMonth": { "type": "number", "exclusiveMinimum": 0 },
        "maxMinutesPerRun": { "type": "number", "exclusiveMinimum": 0 },
        "maxItemsPerSource": { "type": "number", "exclusiveMinimum": 0 },
        "maxModelItemsPerRun": { "type": "number", "exclusiveMinimum": 0 },
        "maxDraftsPerRun": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "lookAheadDays": {
      "description": "Days ahead scout reads, for a source that sets no lookAheadDays of its own.",
      "type": "integer",
      "minimum": 60,
      "maximum": 365
    },
    "lowWater": {
      "type": "object",
      "required": ["upcomingEvents"],
      "additionalProperties": false,
      "properties": {
        "upcomingEvents": {
          "description": "The run log and digest warn when fewer published upcoming events than this are on the site.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sources": { "const": "sources.yaml" },
    "coverage": { "const": "coverage.md" },
    "area": { "const": "area.yaml" },
    "safety": { "const": "safety.yaml" },
    "background": {
      "description": "The neighborhood background the model stages are given (stage-context.md): a summary always, a topic note only when verify names it, all within one token budget.",
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "stages", "maxTokens", "topics"],
      "properties": {
        "summary": { "type": "string", "pattern": "^background/[a-z-]+\\.md$" },
        "stages": {
          "description": "The model stages that get the summary, and any topic notes verify names.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["verify", "curate", "draft"] }
        },
        "maxTokens": {
          "description": "The most the background adds to one stage's message, the summary included (four characters to a token).",
          "type": "integer",
          "minimum": 200,
          "maximum": 20000
        },
        "topics": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "file", "covers"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/sourceId" },
              "file": { "type": "string", "pattern": "^background/[a-z-]+\\.md$" },
              "covers": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt", "input", "output", "model"],
        "additionalProperties": false,
        "properties": {
          "id": { "enum": ["scout", "verify", "curate", "draft", "submit"] },
          "prompt": { "type": "string", "pattern": "^prompts/[a-z-]+\\.md$" },
          "input": { "type": "string", "pattern": "^schemas/[a-z-]+\\.schema\\.json$" },
          "output": { "type": "string", "pattern": "^schemas/[a-z-]+\\.schema\\.json$" },
          "model": { "enum": ["none", "medium", "high"] }
        }
      },
      "minItems": 5,
      "maxItems": 5
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifyBelowConfidence", "to"],
      "properties": {
        "verifyBelowConfidence": {
          "description": "Rerun verify at this effort when its confidence is below this; still below after the rerun sends the item to review.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "to": { "const": "high" }
      }
    },
    "promotionGuard": {
      "description": "Code refuses to submit an accept, and sends it to the needs-review route, when verify's confidence is below escalation.verifyBelowConfidence or its flags include one of these, whatever the model decided.",
      "type": "object",
      "additionalProperties": false,
      "required": ["blockingFlags"],
      "properties": {
        "blockingFlags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/flag" }
        }
      }
    },
    "routes": {
      "description": "Which MCP tool the submit stage calls for each curate decision (prompts/submit.md). The check holds every eval case to it. Only an accept may be routed to a suggestion; the runner's gate (runner/lib/gate.mjs) also refuses it for any held item.",
      "type": "object",
      "additionalProperties": false,
      "required": ["accept", "needs-review", "update", "cancel", "reject", "duplicate"],
      "properties": {
        "accept": { "enum": ["submitSuggestion", "reportItem", "none"] },
        "needs-review": { "const": "reportItem" },
        "update": { "const": "reportItem" },
        "cancel": { "const": "reportItem" },
        "reject": { "enum": ["reportItem", "none"] },
        "duplicate": { "enum": ["reportItem", "none"] }
      }
    }
  }
}
