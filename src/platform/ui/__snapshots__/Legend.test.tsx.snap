// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Legend > draws the Diagram key (snapshot) 1`] = `"<div class="not-prose mb-10 rounded-2xl border border-border bg-surface p-4 shadow-sm md:p-6 -mt-[calc(var(--figure-gap)_-_var(--legend-gap))]"><ol role="list" aria-label="Diagram key" class="grid grid-cols-1 gap-x-6 gap-y-3 sm:grid-cols-2"><li class="flex items-start gap-3"><span aria-hidden="true" class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-base font-bold text-on-image ring-2 ring-on-image">1</span><p class="pt-0.5 text-base leading-snug text-foreground"><span class="sr-only">Marker 1: </span><span class="font-semibold">North roundabout</span><span class="sr-only">: </span><span aria-hidden="true" class="text-muted-foreground">&nbsp;· </span>Ramps meet the crossing road.</p></li><li class="flex items-start gap-3"><span aria-hidden="true" class="flex size-7 shrink-0 items-center justify-center rounded-full bg-accent text-base font-bold text-on-image ring-2 ring-on-image">2</span><p class="pt-0.5 text-base leading-snug text-foreground"><span class="sr-only">Marker 2: </span><span class="font-semibold">Westbound loop</span></p></li></ol></div>"`;
